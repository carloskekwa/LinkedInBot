# Dry-run is the default. Live mode also requires explicit risk acknowledgement.
ACKNOWLEDGE_PLATFORM_RISK=false
DATA_DIR=./data
BROWSER_PROFILE=./user-data
INVITATION_POLL_MS=20000
MESSAGE_POLL_MS=10000
DEBOUNCE_MS=7000
MAX_DEBOUNCE_MS=20000
MAX_ACTIONS_PER_HOUR=60
THREAD_LIMIT=30
CONTEXT_MESSAGES=8
MAX_INPUT_CHARS=12000
RETENTION_DAYS=7
LOG_LEVEL=info
# Local OpenAI-compatible model server by default.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=llama3.2
LLM_API_KEY=
LLM_TIMEOUT_MS=15000
# Remote providers receive private conversation text. Explicit consent is required.
ALLOW_EXTERNAL_LLM=false
SYSTEM_PROMPT=./prompts/system.md
FALLBACK_REPLY=I'm the account owner's automated assistant, and I can't answer that reliably right now.
# Initial history: baseline = observe existing messages without replying;
# reply-latest = opt in to replying to the latest existing inbound batch.
INITIAL_HISTORY=baseline
# Optional JSON overrides of centralized selectors, not credentials.
SELECTORS_FILE=

# Dry-run is the default. Live mode also requires explicit risk acknowledgement.
ACKNOWLEDGE_PLATFORM_RISK=false
DATA_DIR=./data
BROWSER_PROFILE=./user-data
# Your own logged-in account's profile URL; avoids dependence on the owner menu.
OWNER_PROFILE_URL=
INVITATION_POLL_MS=20000
MESSAGE_POLL_MS=10000
# Full page reloads (polls in between only read the live page). Keep these conservative:
# LinkedIn rejects frequent reloads with HTTP errors. Lower = faster acceptance, higher risk.
INVITATION_REFRESH_MS=180000
MESSAGE_REFRESH_MS=300000
# After accepting a connection, reload the messaging page this many ms later (+/-20%) so the
# new connection's thread moves from "Other" into the inbox and gets answered.
POST_ACCEPT_REFRESH_MS=60000
DEBOUNCE_MS=7000
MAX_DEBOUNCE_MS=20000
MAX_ACTIONS_PER_HOUR=60
THREAD_LIMIT=30
CONTEXT_MESSAGES=8
MAX_INPUT_CHARS=12000
RETENTION_DAYS=7
LOG_LEVEL=info
# OpenAI API. Add your private API key locally; never commit it.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT_MS=15000
# OpenAI receives conversation context. Set false to disable external-provider use.
ALLOW_EXTERNAL_LLM=true
# Set true to log each incoming message and the AI's answer (private data; local debugging).
LOG_MESSAGE_TEXT=false
# Set true to print ONLY {incomingMessages, aiAnswer} per reply (hides info logs; warnings/errors stay).
LOG_CONVERSATION_ONLY=false
SYSTEM_PROMPT=./prompts/system.md
# Optional private facts the bot may state about you (copy prompts/owner-facts.example.md).
OWNER_FACTS_FILE=./prompts/owner-facts.md
FALLBACK_REPLY=Thanks for your message! This is an automated reply, and I can't give you a proper answer right now.
# Higher = more varied, human-sounding wording; lower = more predictable.
LLM_TEMPERATURE=0.8
# Initial history: baseline = observe existing messages without replying;
# reply-latest = opt in to replying to the latest existing inbound batch.
INITIAL_HISTORY=baseline
# Optional JSON overrides of centralized selectors, not credentials.
SELECTORS_FILE=
